{
  "type": "kafka",
  "spec": {
    "dataSchema": {
      "dataSource": "orders_late_policy",
      "timestampSpec": {
        "column": "event_time",
        "format": "iso"
      },
      "dimensionsSpec": {
        "dimensions": [
          {
            "name": "event_id",
            "type": "string"
          },
          {
            "name": "order_id",
            "type": "string"
          },
          {
            "name": "run_id",
            "type": "string"
          },
          {
            "name": "store_id",
            "type": "string"
          },
          {
            "name": "country",
            "type": "string"
          },
          {
            "name": "channel",
            "type": "string"
          },
          {
            "name": "event_type",
            "type": "string"
          },
          {
            "name": "currency",
            "type": "string"
          },
          {
            "name": "ingested_at",
            "type": "string"
          },
          {
            "name": "amount_cents",
            "type": "long"
          },
          {
            "name": "schema_version",
            "type": "long"
          },
          {
            "name": "campaign",
            "type": "string"
          }
        ]
      },
      "metricsSpec": [],
      "granularitySpec": {
        "type": "uniform",
        "segmentGranularity": "HOUR",
        "queryGranularity": "NONE",
        "rollup": false
      }
    },
    "ioConfig": {
      "type": "kafka",
      "topic": "orders",
      "consumerProperties": {
        "bootstrap.servers": "kafka:29092"
      },
      "inputFormat": {
        "type": "json"
      },
      "useEarliestOffset": true,
      "replicas": 1,
      "taskCount": 1,
      "taskDuration": "PT10M",
      "lateMessageRejectionPeriod": "PT1H"
    },
    "tuningConfig": {
      "type": "kafka",
      "maxRowsInMemory": 50000,
      "maxRowsPerSegment": 500000,
      "maxParseExceptions": 100,
      "maxSavedParseExceptions": 10,
      "logParseExceptions": true
    }
  }
}
